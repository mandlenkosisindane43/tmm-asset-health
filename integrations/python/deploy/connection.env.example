# Copy outside the repository to /etc/tmm-transfer/connection.env; restrict permissions.
# Supply a real authorised connection. These values deliberately cannot send data.
TMM_TELEMETRY_ENDPOINT=https://YOUR-TMM-HOST/api/telemetry/v2
TMM_TELEMETRY_SOURCE=YOUR-REGISTERED-SOURCE
TMM_TELEMETRY_TOKEN=YOUR-CONNECTION-TOKEN
