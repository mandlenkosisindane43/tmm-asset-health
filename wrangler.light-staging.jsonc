{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmm-asset-health-light-staging",
  "account_id": "ba53c9a85c6f300723d5d58f899722f9",
  "main": "./worker/entry-with-pwa.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tmm-asset-health-light-staging-db",
    "database_id": "b7f64035-831b-45ab-8a6c-036a67368bd7"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "tmm-asset-health-light-staging-files"
  }],
  "observability": { "enabled": true }
}
